rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // UPI QR code images uploaded per hostel. Readable by anyone (needed to
    // render the payment QR), writable only by the admin of that exact hostel.
    match /qr/{hostelId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && resource == null
        && get(/databases/(default)/documents/admins/$(request.auth.uid)).data.hostelId == hostelId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // No catch-all rule: every other path in the bucket is denied by default.
  }
}